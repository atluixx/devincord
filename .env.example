# Copy to .env — never commit the real one.
DISCORD_TOKEN=...
# Devin personal access token (cog_...) from Settings → Devin API → PATs.
DEVIN_API_KEY=cog_...
# Organization ID (org-...) the sessions are created in.
DEVIN_ORG_ID=org-...
# Comma-separated Discord user IDs allowed to start and message sessions.
ALLOWED_USER_IDS=
# Optional: guild-scoped slash sync for fast iteration. Leave empty for global.
DISCORD_GUILD_ID=
# Set to 0/false/no to skip slash command sync.
SYNC_COMMANDS=1
# How often active sessions are polled (min 5s).
POLL_INTERVAL=15s
# Optional per-session ACU cap and session tags (default tag: discord).
MAX_ACU_LIMIT=
DEVIN_TAGS=discord
# Thread ↔ session links.
STORE_PATH=devincord.json
LOG_LEVEL=info
